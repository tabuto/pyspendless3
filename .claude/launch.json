{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pyspendless",
      "runtimeExecutable": ".venv/bin/python3",
      "runtimeArgs": [
        "pyspendless/app.py"
      ],
      "port": 5000
    },
    {
      "name": "probe",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765"
      ],
      "port": 8765
    }
  ]
}
